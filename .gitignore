# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# If you find yourself ignoring temporary files generated by your text editor
# or operating system, you probably want to add a global ignore instead:
#   git config --global core.excludesfile '~/.gitignore_global'

# All financial data exports (Finanzguru, bank statements, etc.)
*.xlsx
*.xls
*.csv
*.numbers
*.ods
!/db/data/schema_samples/*.csv  # Only allow example/schema CSVs

# Database dumps and backups
db/backups/
*.dump
*.dump.gz
*.sql

# ALL data files in db/data/ - contains real transaction data
/db/data/**/*
!/db/data/.keep
!/db/data/schema_samples/
!/db/data/schema_samples/.keep

# Environment files, secrets, keys, credentials
.env*
!.env*.erb
!.env.example
/config/master.key
/config/credentials/*.key
tmp/local_secret.txt
*.pem
*.key
*.crt
*.p12
*.pfx
*.age
*.gpg

# Elster XML files (may contain personal tax data)
*.elster
*_elster.xml
elster_*.xml
/tmp/elster/

# PDF exports (invoices, reports, receipts)
/tmp/exports/
/tmp/pdfs/
/public/invoices/
/public/exports/

# Local database and storage
/storage/*
!/storage/.keep

# Temporary files
/tmp/*
!/tmp/.keep
!/tmp/pids/
!/tmp/pids/.keep
/tmp/cache/
/tmp/backups/
/tmp/snapshots/

# Logs
/log/*
!/log/.keep

# Assets (generated)
/public/assets
/public/packs
/public/packs-test

# Bundler, Ruby, Node
/.bundle
/vendor/bundle
/node_modules
/yarn-error.log
/npm-debug.log
/package-lock.json

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~
.directory

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Editors
*.swp
*.swo
*~
.idea/
.vscode/
*.iml
*.sublime-project
*.sublime-workspace

# Test coverage
/coverage/
/.nyc_output/

# RSpec
/spec/tmp/

# Sidekiq
/dump.rdb
