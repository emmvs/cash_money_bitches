# Environment Variables Template
# 
# For local development, Rails uses config/database.yml and credentials.yml.enc
# You typically DON'T need a .env file unless you're using Docker or deploying.
#
# If you do need environment variables, copy this to .env (which is gitignored)

# Future: Elster API credentials (when that becomes a thing)
# ELSTER_API_KEY=your_key_here
# ELSTER_API_SECRET=your_secret_here

# Future: Production database URL (Heroku, Railway, etc.)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Future: Email/SMTP for sending invoices
# SMTP_ADDRESS=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=your_email@example.com
# SMTP_PASSWORD=your_password
